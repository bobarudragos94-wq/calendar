# Turso / libSQL
# Creeaza baza cu Turso CLI:  turso db create cand-ne-vedem
# URL-ul:                     turso db show cand-ne-vedem --url
# Token:                      turso db tokens create cand-ne-vedem
TURSO_DATABASE_URL=libsql://numele-bazei-tale.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Pentru dezvoltare locala fara Turso poti folosi un fisier SQLite local:
# TURSO_DATABASE_URL=file:local.db
# (in acest caz TURSO_AUTH_TOKEN nu e necesar)
